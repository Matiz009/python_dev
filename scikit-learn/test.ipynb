   "source": [
    "PI_CONSTANT = 3.14159\n",
    "radius = float(input(\"Input target circle radius (r): \"))\n",
    "diameter = 2 * radius\n",
    "circumference = 2 * PI_CONSTANT * radius\n",
    "area = PI_CONSTANT * (radius ** 2)\n",
    "print(f\"Diameter: {diameter:.2f} | Circumference: {circumference:.2f} | Area: {area:.2f}\")"
   ]
