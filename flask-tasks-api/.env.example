# Copy to .env for local development. Never commit the real .env.
# In production these are set as Vercel Environment Variables instead.

# development | testing | production
APP_ENV=development

# Sign cookies and sessions. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Leave unset locally to use the bundled SQLite file (app/../tasks.db).
# In production point this at Postgres. A pooled/PgBouncer URL is strongly
# preferred on serverless. Both postgres:// and postgresql:// are accepted.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Required for POST/PATCH/PUT/DELETE on /api/v1/tasks.
# Unset locally = writes are open. ALWAYS set this in production.
# API_KEY=

# The dynamic table (DDL) API. Destructive: creates and drops real tables.
# Off unless BOTH of these are set.
FEATURE_DYNAMIC_TABLES=false
# ADMIN_API_KEY=

# Comma-separated browser origins allowed to call /api/*. Empty = no CORS.
# CORS_ORIGINS=https://example.com,https://www.example.com

# Pagination bounds
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100

# Rate limiting. In-memory buckets are per-instance and therefore approximate
# on serverless; use Redis for accurate global limits.
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=120 per minute
# RATELIMIT_STORAGE_URI=redis://default:password@host:6379

# Logging
LOG_LEVEL=INFO
LOG_JSON=true
